{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 推奨プリセットをベースに使用
  extends: ["config:recommended"],
  // 有効化するパッケージマネージャ
  enabledManagers: ["github-actions", "mise"],
  // リリースから7日経過したバージョンのみ対象
  minimumReleaseAge: "7 days",
  timezone: "Asia/Tokyo",
  // 毎日9時台に実行
  schedule: ["* 9 * * *"],
  // 全 PR 共通ラベル
  labels: ["dependencies"],
  rebaseWhen: "never",
  // release-please が PR タイトル（squash merge のコミットメッセージ）からバージョンを決めるため、Conventional Commits にする
  semanticCommits: "enabled",
  packageRules: [
    // GitHub Actions
    // composite action・reusable workflow の中のアクションの更新は呼び出し側に届ける必要があるため、fix としてリリースする
    // （このリポジトリ用のワークフローだけの更新でもリリースされるが、区別しないで簡単にしておく）
    {
      matchManagers: ["github-actions"],
      addLabels: ["github-actions"],
      semanticCommitType: "fix",
    },
    // mise（このリポジトリの開発ツールだけなので、リリースしない chore のまま）
    {
      matchManagers: ["mise"],
      addLabels: ["mise"],
    },
  ],
}
