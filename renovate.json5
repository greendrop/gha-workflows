{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // 個人リポジトリ共通の設定を継承（config:recommended・minimumReleaseAge・schedule・ラベルなど）
  // https://github.com/greendrop/renovate-config
  extends: ["github>greendrop/renovate-config:default.json5"],
  // 有効化するパッケージマネージャ
  enabledManagers: ["github-actions", "mise"],
  // release-please が PR タイトル（squash merge のコミットメッセージ）からバージョンを決めるため、Conventional Commits にする
  semanticCommits: "enabled",
  packageRules: [
    // GitHub Actions
    // composite action・reusable workflow の中のアクションの更新は呼び出し側に届ける必要があるため、fix としてリリースする
    // （このリポジトリ用のワークフローだけの更新でもリリースされるが、区別しないで簡単にしておく）
    // ラベル（github-actions / mise）は共通設定で付ける
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "fix",
    },
  ],
}
